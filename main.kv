#:import dp kivy.metrics.dp

<CalculadorScreen>:
    orientation: 'vertical'
    padding: dp(14)
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: (0.067, 0.094, 0.153, 1)  # #111827
        Rectangle:
            pos: self.pos
            size: self.size

    # ENCABEZADO
    BoxLayout:
        size_hint_y: None
        height: dp(54)
        orientation: 'vertical'
        spacing: dp(2)

        Label:
            text: "AppAzar"
            color: (1, 1, 1, 1)
            bold: True
            font_size: '23sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: "CAJA DIARIA  ·  PLANILLA DE RENDICIÓN"
            color: (0.62, 0.69, 0.80, 1)
            font_size: '10sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

    # FECHA
    BoxLayout:
        size_hint_y: None
        height: dp(74)
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: (0.122, 0.161, 0.224, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12)]

        Label:
            text: "FECHA DE LA CAJA"
            size_hint_y: None
            height: dp(16)
            color: (0.68, 0.75, 0.86, 1)
            bold: True
            font_size: '10sp'
            halign: 'left'
            text_size: self.size

        BoxLayout:
            spacing: dp(7)

            Spinner:
                id: spin_dia
                text: "12"
                values: [str(i).zfill(2) for i in range(1, 32)]
                background_normal: ''
                background_color: (0.16, 0.22, 0.32, 1)
                color: (1, 1, 1, 1)
                on_text: root.on_fecha_cambiada()

            Spinner:
                id: spin_mes
                text: "10"
                values: [str(i).zfill(2) for i in range(1, 13)]
                background_normal: ''
                background_color: (0.16, 0.22, 0.32, 1)
                color: (1, 1, 1, 1)
                on_text: root.on_fecha_cambiada()

            Spinner:
                id: spin_anio
                text: "2026"
                values: ["2025", "2026", "2027", "2028"]
                background_normal: ''
                background_color: (0.16, 0.22, 0.32, 1)
                color: (1, 1, 1, 1)
                on_text: root.on_fecha_cambiada()

    Label:
        id: lbl_historial_dia
        text: "Sin registros guardados para esta fecha."
        size_hint_y: None
        height: dp(25)
        color: (0.35, 0.78, 1, 1)
        font_size: '12sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    # CONTENIDO DESPLAZABLE
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(4)
        scroll_type: ['bars', 'content']

        GridLayout:
            cols: 1
            spacing: dp(9)
            padding: 0, 0, 0, dp(8)
            size_hint_y: None
            height: self.minimum_height

            # QUINIELAS
            BoxLayout:
                size_hint_y: None
                height: dp(34)
                padding: dp(10), 0
                canvas.before:
                    Color:
                        rgba: (0.145, 0.235, 0.39, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
                Label:
                    text: "QUINIELAS"
                    color: (1, 1, 1, 1)
                    bold: True
                    font_size: '12sp'
                    halign: 'left'
                    text_size: self.size
                Label:
                    text: "Comisión 12,42%"
                    color: (0.72, 0.82, 1, 1)
                    font_size: '10sp'
                    halign: 'right'
                    text_size: self.size

            GridLayout:
                cols: 1
                spacing: dp(5)
                size_hint_y: None
                height: self.minimum_height

                # Cada fila: nombre / venta / importe a rendir
                BoxLayout:
                    size_hint_y: None
                    height: dp(54)
                    padding: dp(10), dp(5)
                    spacing: dp(7)
                    canvas.before:
                        Color:
                            rgba: (0.122, 0.161, 0.224, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(9)]
                    Label:
                        text: "La Previa"
                        size_hint_x: 0.38
                        color: (0.91, 0.93, 0.97, 1)
                        font_size: '12sp'
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                    TextInput:
                        id: q_previa
                        hint_text: "Venta $"
                        input_filter: 'float'
                        multiline: False
                        size_hint_x: 0.31
                        font_size: '13sp'
                        padding: dp(8), dp(12)
                        background_normal: ''
                        background_active: ''
                        background_color: (0.075, 0.11, 0.18, 1)
                        foreground_color: (1, 1, 1, 1)
                        cursor_color: (0.35, 0.62, 1, 1)
                        hint_text_color: (0.48, 0.55, 0.66, 1)
                        on_text: root.calcular_totales()
                    Label:
                        id: lbl_q_previa
                        text: "$0.00"
                        size_hint_x: 0.31
                        color: (0.34, 0.86, 0.65, 1)
                        bold: True
                        font_size: '12sp'
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size

                BoxLayout:
