<CalculadorScreen>:
    orientation: 'vertical'
    padding: 10
    spacing: 10

    Label:
        text: "Planilla de Rendición y Caja Diaria"
        font_size: 22
        size_hint_y: None
        height: 35
        bold: True

    # ================= SELECCIÓN DE FECHA =================
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 40
        spacing: 5
        
        Spinner:
            id: spin_dia
            text: "12"  
            values: [str(i).zfill(2) for i in range(1, 32)]
            on_text: root.on_fecha_cambiada()
        Spinner:
            id: spin_mes
            text: "10"  
            values: [str(i).zfill(2) for i in range(1, 13)]
            on_text: root.on_fecha_cambiada()
        Spinner:
            id: spin_anio
            text: "2026" 
            values: ["2025", "2026", "2027", "2028"]
            on_text: root.on_fecha_cambiada()

    Label:
        id: lbl_historial_dia
        text: "Sin registros guardados para esta fecha."
        font_size: 14
        color: 0, 0.8, 1, 1
        size_hint_y: None
        height: 20

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        GridLayout:
            cols: 3
            spacing: 10
            size_hint_y: None
            height: self.minimum_height
            row_default_height: 40
            row_force_default: True

            # TITULOS DE COLUMNAS
            Label:
                text: "Juego / Sorteo"
                bold: True
            Label:
                text: "Venta Bruta ($)"
                bold: True
            Label:
                text: "A Rendir ($)"
                bold: True

            # ================= QUINIELAS (12.42%) =================
            Label:
                text: "Quiniela: La Previa"
            TextInput:
                id: q_previa
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_q_previa
                text: "$0.00"

            Label:
                text: "Quiniela: Primera"
            TextInput:
                id: q_primera
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_q_primera
                text: "$0.00"

            Label:
                text: "Quiniela: Matutina"
            TextInput:
                id: q_matutina
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_q_matutina
                text: "$0.00"

            Label:
                text: "Quiniela: Vespertina"
            TextInput:
                id: q_vespertina
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_q_vespertina
                text: "$0.00"

            Label:
                text: "Quiniela: Nocturna"
            TextInput:
                id: q_nocturna
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_q_nocturna
                text: "$0.00"

            # ================= POCEADAS (12.42%) =================
            Label:
                text: "Poceada: 15:00 hs"
            TextInput:
                id: p_15
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_p_15
                text: "$0.00"

            Label:
                text: "Poceada: 21:30 hs"
            TextInput:
                id: p_21
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_p_21
                text: "$0.00"

            # ================= MINI POCEADAS (12.42%) =================
            Label:
                text: "Mini Poceada: 12:15 hs"
            TextInput:
                id: mp_12
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_mp_12
                text: "$0.00"

            Label:
                text: "Mini Poceada: 18:00 hs"
            TextInput:
                id: mp_18
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_mp_18
                text: "$0.00"

            # ================= TELEKINO (10.00%) =================
            Label:
                text: "Telekino"
            TextInput:
                id: tk
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                id: lbl_tk
                text: "$0.00"

            # ================= CARGA DE ACUMULATIVOS (HOY) =================
            Label:
                text: "Quini 6 (Venta Hoy)"
            TextInput:
                id: quini_val
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                text: "Incluye Mié. y Sáb."
                font_size: 11
                color: 0.6, 0.6, 0.6, 1

            Label:
                text: "Loto (Venta Hoy)"
            TextInput:
                id: loto_val
                input_filter: 'float'
                multiline: False
                on_text: root.calcular_totales()
            Label:
                text: "Incluye Mié. y Sáb."
                font_size: 11
                color: 0.6, 0.6, 0.6, 1

    # ================= PANEL FIJO DE TOTALES DIARIOS CON ARRASTRES =================
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: 115
        padding: 8
        spacing: 2
        canvas.before:
            Color:
                rgba: 0.12, 0.12, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            id: lbl_arrastre_info
            text: "Arrastres liquidados hoy: Quini 6: $0.00 | Loto: $0.00"
            font_size: 12
            color: 1, 0.6, 0, 1
        Label:
            id: lbl_total_vendido
            text: "TOTAL VENDIDO DEL DÍA: $0.00"
            font_size: 14
            bold: True
        Label:
            id: lbl_total_comision
            text: "TOTAL COMISIÓN ACUMULADA: $0.00"
            font_size: 14
            bold: True
            color: 1, 1, 0, 1
        Label:
            id: lbl_total_rendir
            text: "TOTAL A RENDIR FINAL: $0.00"
            font_size: 16
            bold: True
            color: 0, 1, 0, 1

    Button:
        text: "Guardar Caja de la Fecha Seleccionada"
        size_hint_y: None
        height: 45
        bold: True
        background_color: 0, 0.6, 1, 1
        on_press: root.guardar_caja_dia()