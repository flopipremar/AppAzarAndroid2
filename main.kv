                    background_active: ''
                    background_color: (0.075, 0.11, 0.18, 1)
                    foreground_color: (1, 1, 1, 1)
                    hint_text_color: (0.48, 0.55, 0.66, 1)
                    on_text: root.calcular_totales()
                Label:
                    text: "Mié. / Sáb."
                    size_hint_x: 0.31
                    color: (0.68, 0.75, 0.86, 1)
                    font_size: '10sp'
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

    # RESUMEN FIJO
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(128)
        padding: dp(12)
        spacing: dp(5)
        canvas.before:
            Color:
                rgba: (0.122, 0.161, 0.224, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(13)]

        Label:
            id: lbl_arrastre_info
            text: "Arrastres liquidados hoy: Quini 6: $0.00 | Loto: $0.00"
            size_hint_y: None
            height: dp(24)
            color: (1, 0.68, 0.28, 1)
            font_size: '10sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            id: lbl_total_vendido
            text: "TOTAL VENDIDO DEL DÍA: $0.00"
            color: (0.91, 0.93, 0.97, 1)
            font_size: '12sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            id: lbl_total_comision
            text: "TOTAL COMISIÓN ACUMULADA: $0.00"
            color: (1, 0.82, 0.30, 1)
            font_size: '12sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            id: lbl_total_rendir
            text: "TOTAL A RENDIR FINAL: $0.00"
            color: (0.34, 0.90, 0.66, 1)
            font_size: '16sp'
            bold: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size

    Button:
        text: "GUARDAR CAJA"
        size_hint_y: None
        height: dp(48)
        bold: True
        font_size: '14sp'
        background_normal: ''
        background_down: ''
        background_color: (0.145, 0.388, 0.92, 1)
        color: (1, 1, 1, 1)
        on_press: root.guardar_caja_dia()
